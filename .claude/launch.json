{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trunk-serve",
      "runtimeExecutable": "/nix/var/nix/profiles/default/bin/nix",
      "runtimeArgs": [
        "--extra-experimental-features",
        "nix-command flakes",
        "develop",
        "--command",
        "trunk",
        "serve"
      ],
      "port": 8080
    },
    {
      "name": "fixtures",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--bind",
        "127.0.0.1",
        "--directory",
        "crates/src-web/tests/fixtures"
      ],
      "port": 8090
    }
  ]
}
